# Standalone bot: no LLM or Helius Wallet API key required.
RPC_URL=https://api.mainnet-beta.solana.com
# MONITOR_RPC_URL=
# MONITOR_WS_URL=
# BALANCE_RPC_URL=
# FALLBACK_RPC_URL=
# WALLET_ADDRESS=public_address_for_read_only_operation
# WALLET_PRIVATE_KEY=base58_secret_for_live_signing
DRY_RUN=true
# PNL_SOURCE=meteora
# PNL_RPC_URL=
# JUPITER_API_KEY is required for authenticated Jupiter price and swap calls. There is no built-in key.
# JUPITER_API_KEY=
# Live-swap referral. The default fee is 0 bps, so swaps add no referral cut.
# Set JUPITER_REFERRAL_FEE_BPS to 50-255 only if you want a Jupiter Ultra referral.
# JUPITER_REFERRAL_ACCOUNT=
# JUPITER_REFERRAL_FEE_BPS=0
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Notifications only. The admin console is disabled in this build.
# TELEGRAM_ALLOWED_USER_IDS=
