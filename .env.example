# Standalone bot: no LLM or Helius Wallet API key required.
RPC_URL=https://api.mainnet-beta.solana.com
# MONITOR_RPC_URL=
# MONITOR_WS_URL=
# BALANCE_RPC_URL=
# FALLBACK_RPC_URL=
# WALLET_ADDRESS=public_address_for_read_only_operation
# WALLET_PRIVATE_KEY=base58_secret_for_live_signing
DRY_RUN=true
# PNL_SOURCE=meteora
# PNL_RPC_URL=
# JUPITER_API_KEY is required for authenticated Jupiter price and swap calls. There is no built-in key.
# JUPITER_API_KEY=
# Optional live-swap referral override. Unset uses the built-in referral account and fee.
# JUPITER_REFERRAL_ACCOUNT=
# JUPITER_REFERRAL_FEE_BPS=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Admin console stays off until this is a comma-separated list of Telegram user ids.
# The console can switch out of shadow mode and can import or display the wallet key.
# TELEGRAM_ALLOWED_USER_IDS=
